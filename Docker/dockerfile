# ── BASE ──────────────────────────────────────────────────────────────────────
FROM ros:jazzy-ros-base

# ── LOCALE (prevents encoding bugs in ROS nodes) ───────────────────────────────
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# ── ROS DOMAIN (must match your laptop's ROS_DOMAIN_ID) ───────────────────────
ENV ROS_DOMAIN_ID=2

# ── PACKAGES ──────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    build-essential \
    python3-colcon-common-extensions \
    python3-pip \
    git \
    nano \
    # Nav2
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    # Serial communication (ESP32 ↔ Pi)
    ros-jazzy-serial-driver \
    python3-serial \
    && rm -rf /var/lib/apt/lists/*

# ── WORKSPACE SETUP ───────────────────────────────────────────────────────────
# Create workspace directory
RUN mkdir -p /root/ros2_ws/src

# Set working directory
WORKDIR /root/ros2_ws

# Build workspace (empty for now, you'll add packages to src/ later)
RUN /bin/bash -c "echo 'source /opt/ros/jazzy/setup.bash' >> ~/.bashrc"
RUN /bin/bash -c "colcon build --symlink-install"
RUN /bin/bash -c "echo 'source /root/ros2_ws/install/setup.bash' >> ~/.bashrc"

# ── ENTRYPOINT ────────────────────────────────────────────────────────────────
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"] 
